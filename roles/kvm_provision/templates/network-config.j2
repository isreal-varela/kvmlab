#cloud-config

network:
  version: 1
  config:
    - type: physical
      name: enp1s0
      subnets:
        - type: static
          address: {{ vm_ip_addr }}/{{ subnet }}
          gateway: {{ gateway }}
          dns_nameservers:
            - 192.168.122.40
          dns_search:
            - {{ dns_search }}
{% if ( vm_net2 is defined and vm_net2 != '' ) and ( vm_ip_addr2 is defined and vm_ip_addr2 != '' )%}
    - type: physical
      name: enp2s0
      subnets:
        - type: static
          address: {{ vm_ip_addr2 }}/{{ subnet }}
          gateway: {{ gateway2 }}
          dns_nameservers:
            - {{ dns1 }}
            - {{ dns2 }}
{% endif %}
